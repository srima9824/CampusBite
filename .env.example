# Copy to .env and replace the placeholders. Never commit .env.
POSTGRES_USER=campusbite
POSTGRES_PASSWORD=change-me
POSTGRES_DB=campusbite
BACKEND_PORT=8000

# Generate with: openssl rand -hex 32  (the app refuses to start with a short secret)
JWT_SECRET=set-me-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=your-openai-model-name
CORS_ORIGINS=http://localhost:5173
REMINDER_STALE_MINUTES=15
REMINDER_CHECK_SECONDS=60
AI_QUESTIONS_PER_MINUTE=5
APP_TIMEZONE=Asia/Kolkata

# Password for the local test accounts created by `python -m app.seed`
SEED_PASSWORD=
