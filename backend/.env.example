# Copy to backend/.env and replace the placeholders. Never commit .env.
DATABASE_URL=postgresql://campusbite:change-me@localhost:5432/campusbite
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=your-openai-model-name
CORS_ORIGINS=http://localhost:5173
REMINDER_STALE_MINUTES=15
