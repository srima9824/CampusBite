# Copy to backend/.env and replace the placeholders. Never commit .env.
DATABASE_URL=postgresql://campusbite:change-me@localhost:5432/campusbite
# Generate with: openssl rand -hex 32  (the app refuses to start with a short secret)
JWT_SECRET=set-me-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=your-openai-model-name
CORS_ORIGINS=http://localhost:5173
REMINDER_STALE_MINUTES=15
